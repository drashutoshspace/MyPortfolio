---
/**
 * A YouTube embed that costs nothing until it is played.
 *
 * The iframe's srcdoc holds a self-hosted poster frame and a play link to the
 * real player. Pressing play navigates the iframe to youtube-nocookie.com, so
 * there is no YouTube request, no cookie and no third-party script on page
 * load, and the site still ships zero JavaScript of its own for this.
 */
import { readFileSync } from "node:fs";
import type { Video } from "~/data/featured";

interface Props {
  video: Video;
}
const { video } = Astro.props;

const player = `https://www.youtube-nocookie.com/embed/${video.id}`;
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");

// Tabler's filled play glyph, the same icon family as the rest of the site.
const play = readFileSync("node_modules/@tabler/icons/icons/filled/player-play.svg", "utf8");

// "PT1M5S" -> "1:05", shown on the button so the cost of pressing it is known.
const [, m = "0", s = "0"] = video.duration.match(/^PT(?:(\d+)M)?(?:(\d+)S)?$/) ?? [];
const length = `${Number(m)}:${s.padStart(2, "0")}`;

// The button sits bottom-left so it never covers a title card in the middle
// of the poster. Colours are fixed rather than themed: the poster is a
// photograph, and white on the site accent reads on it in either theme.
// The srcdoc is its own document, so the site's webfont is not available
// inside it; the system sans stands in at this size.
const doc = `<!doctype html><style>
*{margin:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden;background:#0f1317}
a{position:relative;display:block;height:100%;outline:none}
img{width:100%;height:100%;object-fit:cover;display:block}
span{position:absolute;left:clamp(10px,3%,18px);bottom:clamp(10px,3%,18px);display:flex;align-items:center;gap:7px;height:44px;padding:0 16px 0 12px;border-radius:9px;background:#12468f;color:#fff;font:600 15px/1 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;box-shadow:0 2px 10px rgb(0 0 0 / .3);transition:background .16s,transform .16s}
a:hover span{background:#0c3268;transform:translateY(-1px)}
a:focus-visible span{outline:3px solid #fff;outline-offset:3px}
svg{width:20px;height:20px;flex:none}
b{font-weight:400;opacity:.8}
@media (max-width:480px){span{height:36px;padding:0 12px 0 9px;font-size:13px;gap:5px}svg{width:16px;height:16px}}
@media (prefers-reduced-motion:reduce){span{transition:none}a:hover span{transform:none}}
</style><a href="${player}?autoplay=1&amp;rel=0" aria-label="Play video, ${length}: ${esc(video.title)}"><img src="${video.poster}" alt=""><span>${play}Play <b>${length}</b></span></a>`;
---

<div class="plate video">
  <iframe
    src={`${player}?rel=0`}
    srcdoc={doc}
    title={video.title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<style>
  .video { aspect-ratio: 16 / 9; min-height: 0; }
  .video iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
