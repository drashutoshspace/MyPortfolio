---
import { profile } from "~/data/profile";

const items = [
  { label: "Research", href: "/research/" },
  { label: "Projects", href: "/projects/" },
  { label: "Publications", href: "/publications/" },
  { label: "CV", href: "/cv/" },
  { label: "Contact", href: "/contact/" },
];

const here = Astro.url.pathname;
const isActive = (href: string) => here === href || here.startsWith(href);
---

<header class="masthead no-print">
  <div class="shell inner">
    <a href="/" class="wordmark">{profile.name}</a>
    <nav aria-label="Primary">
      <ul>
        {
          items.map((i) => (
            <li>
              <a href={i.href} class:list={["item", { on: isActive(i.href) }]} aria-current={isActive(i.href) ? "page" : undefined}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead { border-bottom: 1px solid var(--rule); background: var(--bg); }

  .inner {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    min-height: 60px;
    padding-block: 0.45rem;
  }

  .wordmark {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    /* Tap target: the critic measured C's masthead links at 17px, below the
       WCAG 2.2 AA minimum of 24px. */
    padding-block: 0.35rem;
  }

  nav { margin-left: auto; }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem clamp(0.8rem, 2.4vw, 1.6rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    display: block;
    font-size: 0.92rem;
    color: var(--ink-2);
    text-decoration: none;
    /* 24px minimum tap target, plus the row gap keeps the spacing exception. */
    padding-block: 0.42rem;
    border-bottom: 2px solid transparent;
  }
  .item:hover { color: var(--accent); }
  .item.on { color: var(--ink); border-bottom-color: var(--accent); font-weight: 600; }

  @media (max-width: 620px) {
    nav { margin-left: 0; width: 100%; }
    ul { gap: 0.15rem 1.1rem; }
    .item { font-size: 0.88rem; }
  }
</style>
