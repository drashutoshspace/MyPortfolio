---
import type { Talk } from "~/data/talks";

interface Props {
  items: Talk[];
  label: string;
}
const { items, label } = Astro.props;
---

{/* A real list, so a screen reader announces how many items there are and the
    strip is navigable by keyboard once focus enters it. */}
<ul class="gallery" role="list" aria-label={label} tabindex="0">
  {
    items.map((t) => (
      <li>
        <figure>
          {t.href ? (
            <a href={t.href} class:list={["plate", { "plate--illustration": t.kind === "illustration", "plate--figure": t.kind === "figure" }]} style="aspect-ratio: 4 / 3">
              <img src={t.src} alt={t.caption} width="1200" height="900" loading="lazy" decoding="async" style={t.focus ? `object-position:${t.focus}` : undefined} />
            </a>
          ) : (
            <div class:list={["plate", { "plate--illustration": t.kind === "illustration", "plate--figure": t.kind === "figure" }]} style="aspect-ratio: 4 / 3">
              <img src={t.src} alt={t.caption} width="1200" height="900" loading="lazy" decoding="async" style={t.focus ? `object-position:${t.focus}` : undefined} />
            </div>
          )}
          <figcaption>
            <span class="g-title">{t.href ? <a class="g-link" href={t.href}>{t.title}</a> : t.title}</span>
            <span class="g-where">{t.where}, {t.year}</span>
            {t.kind === "illustration" && <span class="kind">Illustration</span>}
            {t.credit && <a class="kind credit" href={t.credit.href} rel="noopener">{t.credit.text}</a>}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .g-link { color: inherit; text-decoration: none; }
  .g-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .kind { display: block; margin-top: 0.2rem; }
  .credit { color: var(--ink-3); text-decoration: underline; text-underline-offset: 2px; }
</style>
