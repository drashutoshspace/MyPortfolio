---
/**
 * A figure plate: a photograph, a figure from a paper, or an illustration,
 * always with its caption underneath.
 *
 * `kind` keeps the record honest. A generated illustration is labelled as one
 * in the caption, so nobody mistakes a drawing for a field photograph, and in
 * the dark theme it is inverted so the drawing reads as light ink on the dark
 * page instead of a white card. A plate with no `src` renders nothing.
 */
interface Props {
  caption: string;
  src?: string;
  alt?: string;
  /** CSS aspect-ratio, e.g. "4 / 3". */
  ratio?: string;
  eager?: boolean;
  kind?: "photo" | "figure" | "illustration";
  /** object-position for the crop, e.g. "50% 30%". */
  focus?: string;
}
const { caption, src, alt, ratio = "4 / 3", eager = false, kind = "photo", focus } = Astro.props;
// Intrinsic dimensions from the ratio, so the img reserves its box even before
// the container's aspect-ratio applies. 1600 wide is a sane upper bound.
const [rw, rh] = ratio.split("/").map((n) => Number(n.trim()));
const w = 1600, h = Math.round((1600 * rh) / rw);
---

{
  src && (
    <figure>
      <div class:list={["plate", { "plate--illustration": kind === "illustration", "plate--figure": kind === "figure" }]} style={`aspect-ratio:${ratio}`}>
        <img
          src={src}
          alt={alt ?? caption}
          width={w}
          height={h}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={eager ? "high" : undefined}
          style={focus ? `object-position:${focus}` : undefined}
        />
      </div>
      <figcaption>
        {caption}
        {kind === "illustration" && <span class="kind"> Illustration.</span>}
      </figcaption>
    </figure>
  )
}
