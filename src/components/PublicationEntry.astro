---
import type { Publication } from "~/data/publications";

interface Props {
  pub: Publication;
  linked?: boolean;
  compact?: boolean;
}
const { pub, linked = true, compact = false } = Astro.props;

const statusLabel: Record<Publication["status"], string> = {
  published: "",
  "in-review": "Under review",
  "in-submission": "In submission",
};

/* Only links that actually resolve are rendered. The reviewed mockup shipped
   13 dead href="#" links labelled paper / video / bibtex; a panel clicking
   "paper" and landing back at the top reads as a broken site. */
const links: { label: string; href: string }[] = [];
if (pub.doi) links.push({ label: "DOI", href: `https://doi.org/${pub.doi}` });
for (const u of pub.urls ?? []) links.push(u);
---

<article class="entry">
  <div class="meta">
    <span class="key venue">{pub.venueShort}</span>
    <span class="key tnum">{pub.year}</span>
  </div>

  <div class="body">
    <h3 class="title">
      {linked ? <a href={`/publications/${pub.slug}/`}>{pub.title}</a> : pub.title}
    </h3>

    <p class="authors">
      {
        pub.authors.map((a, i) => (
          <>
            {i > 0 && ", "}
            <span class:list={["au", { me: a.me }]}>
              {a.name}
              {a.equal && "*"}
            </span>
          </>
        ))
      }
    </p>

    <p class="venue-full">{pub.venue}</p>

    {!compact && pub.summary && <p class="summary">{pub.summary}</p>}

    {
      (links.length > 0 || statusLabel[pub.status] || !pub.peerReviewed) && (
        <p class="links">
          {links.map((l) => (
            <a class="ln" href={l.href} rel="noopener">
              {l.label === "DOI" && pub.doi ? `doi:${pub.doi}` : l.label}
            </a>
          ))}
          {statusLabel[pub.status] && <span class="ln flag">{statusLabel[pub.status]}</span>}
          {!pub.peerReviewed && pub.status === "published" && (
            <span class="ln flag">Not peer reviewed</span>
          )}
        </p>
      )
    }

    {pub.award && <p class="award"><span class="badge">{pub.award}</span></p>}
    {pub.equalAuthorship && <p class="fn">* Equal authorship.</p>}
  </div>
</article>

<style>
  .entry {
    display: grid;
    gap: 0.3rem 1.5rem;
    padding-block: 1.3rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  @media (min-width: 760px) { .entry { grid-template-columns: 9rem minmax(0, 1fr); } }

  .meta { display: flex; gap: 0.65rem; align-items: baseline; padding-top: 0.3rem; }
  @media (min-width: 760px) { .meta { flex-direction: column; gap: 0.15rem; } }

  .title { font-size: 1.03rem; line-height: 1.3; margin-bottom: 0.3rem; }
  .title a { text-decoration: none; color: var(--ink); }
  .title a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .authors { font-size: 0.85rem; line-height: 1.5; color: var(--ink-3); margin: 0 0 0.1rem; max-width: none; }
  .au.me { font-weight: 600; color: var(--ink-2); }

  .venue-full { font-family: var(--serif); font-size: 0.87rem; font-style: italic; color: var(--ink-3); margin: 0 0 0.4rem; max-width: none; }

  .summary { font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); margin: 0 0 0.5rem; }

  .links { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; margin: 0; max-width: none; }
  .ln { font-family: var(--mono); font-size: 0.73rem; color: var(--ink-3); text-decoration: none; }
  a.ln { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  a.ln:hover { color: var(--accent-hover); }
  .flag { border: 1px solid var(--rule-strong); border-radius: 2px; padding: 0.06em 0.4em; }

  .award { margin: 0.6rem 0 0; max-width: none; }
  .fn { font-family: var(--mono); font-size: 0.7rem; color: var(--ink-3); margin: 0.4rem 0 0; max-width: none; }
</style>
