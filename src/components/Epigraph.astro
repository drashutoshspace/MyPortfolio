---
/**
 * Sanskrit only: Devanagari with an italic IAST transliteration beneath, and a
 * verse reference in Devanagari numerals so the whole block stays in one
 * script. No translation and no explanation, at the author's request.
 *
 * The verse is chosen deterministically from the page path at build time, so
 * every route carries a different one and every route carries the same one on
 * every visit. No API call, no client JavaScript, nothing to shift or flicker.
 */
import { shlokaFor } from "~/data/shlokas";

const s = shlokaFor(Astro.url.pathname);
---

<aside class="epigraph">
  <p class="deva" lang="sa">{s.deva}</p>
  <p class="iast" lang="sa-Latn">{s.iast}<span class="ref">{s.ref}</span></p>
</aside>

<style>
  .epigraph {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
    padding-block: clamp(1.2rem, 2.6vw, 1.7rem);
    border-bottom: 1px solid var(--rule);
  }

  .deva {
    font-family: "Noto Serif Devanagari", var(--serif);
    font-size: clamp(1rem, 2.1vw, 1.3rem);
    line-height: 1.8;
    color: var(--ink);
    margin: 0;
    max-width: none;
  }

  .iast {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.87rem;
    line-height: 1.5;
    color: var(--ink-3);
    margin: 0;
    max-width: none;
  }

  .ref {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.72rem;
    margin-left: 0.6rem;
    opacity: 0.75;
  }
</style>
