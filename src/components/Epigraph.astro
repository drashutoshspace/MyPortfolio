---
/**
 * Devanagari only. No transliteration, no verse number, no translation.
 */
import { shlokaFor } from "~/data/shlokas";

const s = shlokaFor(Astro.url.pathname);
---

<aside class="epigraph">
  <p class="deva" lang="sa">{s.deva}</p>
</aside>

<style>
  .epigraph {
    display: flex;
    justify-content: center;
    text-align: center;
    padding-block: clamp(1.3rem, 2.8vw, 1.9rem);
    border-bottom: 1px solid var(--rule);
  }

  .deva {
    font-family: "Noto Serif Devanagari", var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2.8vw, 1.75rem);
    line-height: 1.85;
    color: var(--ink);
    margin: 0;
    max-width: none;
  }
</style>
