---
import Base from "~/layouts/Base.astro";
import PublicationEntry from "~/components/PublicationEntry.astro";
import { profile } from "~/data/profile";
import { themes } from "~/data/research";
import { moonbot } from "~/data/featured";
import { publications, peerReviewedCount } from "~/data/publications";

const latest = publications
  .filter((p) => p.status === "published")
  .sort((a, b) => b.year - a.year)
  .slice(0, 3);
---

<Base
  title="Research"
  description={`${profile.interests} Legged locomotion for space at Istituto Italiano di Tecnologia, MoonBot modular reconfigurable lunar robots at Tohoku University, and learning-based autonomy tested in lunar-analogue terrain.`}
  path="/research/"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Research", path: "/research/" }]}
>
  <header class="section head">
    <h1>Research</h1>
    <p class="statement">{profile.interests}</p>
    <p class="prose lede">
      Space is where the constraints bite: terrain nobody has surveyed, lighting with almost
      no usable shadow gradient, and no chance of a person walking over to help. The work
      falls into three directions, and most of it has been taken out of the lab into terrain
      chosen to stand in for the Moon.
    </p>
  </header>

  <section class="section">
    <div class="spot">
      <a class="spot__media plate" href={moonbot.href} style="aspect-ratio: 16 / 9">
        <img src="/media/robotics/luna-dragon-crater-rim.webp" alt="MoonBot in Dragon configuration driving on a crater rim in grey regolith simulant under hard low-angle light." width="1600" height="900" loading="eager" decoding="async" />
      </a>
      <div>
        <p class="key">Doctoral work, {moonbot.lab}</p>
        <h2><a class="head-link" href={moonbot.href}>MoonBot</a></h2>
        <p class="sk">{moonbot.oneLine}</p>
        <p class="no-print"><a class="btn btn--primary" href={moonbot.href}>MoonBot in depth, with video</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Directions</h2>
    </div>
    <ul class="topics">
      {
        themes.map((t) => (
          <li>
            <a class="tcard" href={`/research/${t.slug}/`}>
              {t.image && (
                <div class:list={["plate", { "plate--illustration": t.image.kind === "illustration", "plate--figure": t.image.kind === "figure" }]} style="aspect-ratio: 3 / 2">
                  <img src={t.image.src} alt={t.image.alt ?? t.image.caption} width="1200" height="800" loading="lazy" decoding="async" style={t.image.focus ? `object-position:${t.image.focus}` : undefined} />
                </div>
              )}
              <span class="tt">{t.title}</span>
              {t.current && <span class="now">Current work</span>}
              <span class="q">{t.question}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Recent publications</h2>
      <span class="key">{peerReviewedCount} peer reviewed in total</span>
    </div>
    {latest.map((p) => <PublicationEntry pub={p} compact />)}
    <p class="actions no-print">
      <a class="btn btn--primary" href="/publications/">All publications</a>
      <a class="btn" href="/publications.bib">Download citations <span class="btn__sub">BibTeX</span></a>
      <a class="btn" href={profile.links.scholar} rel="me noopener">Google Scholar</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Labs and partners</h2>
    </div>
    <p class="prose">
      The Dynamic Legged Systems lab at Istituto Italiano di Tecnologia (IIT) in Genova, where I
      work now; the Space Robotics Lab at Tohoku University, where MoonBot was built; the JAXA
      Space Exploration Test Field, where it was field tested; and the groups before them.
      <a class="link" href="/collaborations/">Everyone the work has been done with</a>.
    </p>
  </section>
</Base>

<style>
  .head { padding-bottom: 0; }
  .statement {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.3vw, 1.45rem);
    line-height: 1.4;
    color: var(--ink);
    margin: 1rem 0 0;
    max-width: 34ch;
  }
  .lede { margin-top: 1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.4rem 0 0; max-width: none; }

  .spot { display: grid; gap: 1.2rem clamp(1.5rem, 4vw, 2.5rem); align-items: center; }
  @media (min-width: 760px) { .spot { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
  .spot h2 { margin-top: 0.3rem; }
  .sk { font-size: 0.98rem; line-height: 1.55; color: var(--ink-2); margin: 0.6rem 0 1.1rem; }

  .head-link { text-decoration: none; color: var(--ink); }
  .head-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .topics { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem 1.6rem; }
  @media (min-width: 900px) { .topics { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tcard { display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none; color: var(--ink); }
  .tcard .plate { margin-bottom: 0.6rem; }
  .tt { font-family: var(--serif); font-weight: 600; font-size: 1.1rem; line-height: 1.25; }
  .tcard:hover .tt { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .now { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); }
  .q { font-size: 0.95rem; line-height: 1.5; color: var(--ink-2); }
</style>
