---
import Base from "~/layouts/Base.astro";
import { themes } from "~/data/research";
import { profile } from "~/data/profile";
---

<Base
  title="Research"
  description="Three research directions: legged locomotion for space, modular reconfigurable lunar robots, and learning and autonomy for field robots."
  path="/research/"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Research", path: "/research/" }]}
>
  <header class="section head">
    <h1>Research</h1>
    <p class="prose lede">
      Three directions, one problem: getting robots to do useful physical work on a
      surface where nobody can come and help them.
    </p>
  </header>

  <div class="list">
    {
      themes.map((t) => (
        <article class="item">
          <div class="side">
            {t.current && <p class="label now-label"><span class="now" aria-hidden="true" />Current</p>}
            {t.publications.length > 0 && (
              <p class="label tnum">{t.publications.length} papers</p>
            )}
          </div>
          <div class="body">
            <h2><a href={`/research/${t.slug}/`}>{t.title}</a></h2>
            <p class="q">{t.question}</p>
            <p class="k">{t.kicker}</p>
            <p><a class="link go" href={`/research/${t.slug}/`}>Read more &rarr;</a></p>
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .head { padding-bottom: 0; }
  .lede { margin-top: 0.9rem; font-size: 1.06rem; color: var(--ink-2); }
  .list { padding-top: 2rem; padding-bottom: 2rem; }
  .item {
    display: grid;
    gap: 0.5rem 1.6rem;
    padding-block: 1.8rem;
    border-bottom: 1px solid var(--rule-soft);
    align-items: start;
  }
  @media (min-width: 780px) { .item { grid-template-columns: 9.5rem minmax(0, 1fr); } }
  .side { display: flex; flex-direction: column; gap: 0.3rem; padding-top: 0.4rem; }
  .now-label { display: flex; align-items: center; gap: 0.45rem; color: var(--ink-2); }
  .now { width: 6px; height: 6px; background: var(--accent); flex: none; }
  .body h2 { font-size: 1.3rem; margin-bottom: 0.5rem; }
  .q { font-size: 1.02rem; line-height: 1.5; margin-bottom: 0.5rem; }
  .k { font-family: var(--f-display); font-size: 0.88rem; color: var(--ink-3); margin-bottom: 0.7rem; }
  .go { font-family: var(--f-display); font-size: 0.88rem; }
</style>
