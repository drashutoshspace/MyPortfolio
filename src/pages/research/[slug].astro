---
import Base from "~/layouts/Base.astro";
import PublicationEntry from "~/components/PublicationEntry.astro";
import { themes } from "~/data/research";
import { getPublication } from "~/data/publications";
import { projects } from "~/data/projects";
import Plate from "~/components/Plate.astro";

export function getStaticPaths() {
  return themes.map((theme) => ({ params: { slug: theme.slug }, props: { theme } }));
}

const { theme } = Astro.props;
const pubs = theme.publications
  .map((s) => getPublication(s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const themeProjects = projects.filter((p) => p.themes?.includes(theme.slug));
---

<Base
  title={theme.title}
  description={theme.kicker}
  path={`/research/${theme.slug}/`}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Research", path: "/research/" },
    { name: theme.title, path: `/research/${theme.slug}/` },
  ]}
>
  <article class="section">
    <p class="key crumb"><a class="link" href="/research/">Research</a></p>

    <h1>{theme.title}</h1>
    {theme.current && <p class="key now-label"><span class="now" aria-hidden="true" />Current work</p>}

    <h2 class="question">{theme.question}</h2>

    {
      theme.image && (
        <div class="lead-fig no-print">
          <Plate src={theme.image.src} caption={theme.image.caption} alt={theme.image.alt} kind={theme.image.kind} focus={theme.image.focus} ratio="16 / 9" eager />
        </div>
      )
    }

    <div class="prose body">
      {theme.body.map((para) => <p>{para}</p>)}
    </div>

    {
      theme.spotlight && (
        <p class="spot no-print">
          <a class="btn btn--primary" href={theme.spotlight.href}>{theme.spotlight.label}</a>
        </p>
      )
    }

    {
      theme.fieldwork && theme.fieldwork.length > 0 && (
        <section class="fieldbox">
          <p class="key">Field tested at</p>
          <ul>
            {theme.fieldwork.map((f) => <li>{f}</li>)}
          </ul>
        </section>
      )
    }

    {
      themeProjects.length > 0 && (
        <section class="pubs">
          <div class="section-head">
            <h2>Projects in this direction</h2>
            <span class="key tnum">{themeProjects.length}</span>
          </div>
          <ul class="projs">
            {themeProjects.map((p) => (
              <li>
                <h3><a class="head-link" href={`/projects/${p.slug}/`}>{p.title}</a></h3>
                <p class="pk">{p.kicker}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      pubs.length > 0 && (
        <section class="pubs">
          <div class="section-head">
            <h2>Publications in this direction</h2>
            <span class="key tnum">{pubs.length}</span>
          </div>
          {pubs.map((p) => <PublicationEntry pub={p} />)}
        </section>
      )
    }
  </article>
</Base>

<style>
  .crumb { margin-bottom: 1.2rem; }
  .now-label { display: flex; align-items: center; gap: 0.45rem; margin-top: 0.8rem; color: var(--ink-2); }
  .now { width: 6px; height: 6px; background: var(--accent); flex: none; }
  .question {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 34ch;
    margin-top: 1.3rem;
    letter-spacing: 0;
  }
  .body { margin-top: 1.6rem; font-size: 1.05rem; }
  .spot { margin: 1.5rem 0 0; max-width: none; }
  .fieldbox {
    margin-top: 2.2rem;
    padding: 1.1rem 1.25rem 1.25rem;
    background: var(--bg-alt);
    border: 1px solid var(--rule);
  }
  .fieldbox ul { list-style: none; margin: 0.55rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .fieldbox li { font-family: var(--sans); font-size: 0.9rem; }
  .pubs { margin-top: 3rem; }
  .lead-fig { margin-top: 1.8rem; }
  .projs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .projs li { padding-block: 1rem; border-top: 1px solid var(--rule); }
  .projs li:last-child { border-bottom: 1px solid var(--rule); }
  .projs h3 { font-size: 1.02rem; }
  .pk { font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); margin: 0.3rem 0 0; }
  .head-link { text-decoration: none; color: var(--ink); }
  .head-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
</style>
