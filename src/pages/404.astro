---
import Base from "~/layouts/Base.astro";
import Email from "~/components/Email.astro";
import { profile } from "~/data/profile";
---

<Base title="Page not found" description="That page does not exist." path="/404/">
  <section class="section">
    <p class="label">HTTP 404</p>
    <h1>That page is not here</h1>
    <p class="prose">
      The link may be old, or I may have moved something. The
      <a class="link" href="/publications/">publications</a> and
      <a class="link" href="/research/">research</a> pages are the two most likely
      places you were heading. If something is genuinely broken, tell me at
      <Email />.
    </p>
  </section>
</Base>

<style>
  .section { padding-block: clamp(3rem, 12vh, 7rem); }
  h1 { margin-top: 0.7rem; }
  .prose { margin-top: 1.1rem; }
</style>
