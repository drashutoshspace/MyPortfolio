---
import Base from "~/layouts/Base.astro";
import PublicationEntry from "~/components/PublicationEntry.astro";
import { byYear, pending, peerReviewedCount } from "~/data/publications";
import { profile } from "~/data/profile";

const groups = byYear();
---

<Base
  title="Publications"
  description={`Peer-reviewed publications by ${profile.name} on space robotics, modular reconfigurable lunar robots, legged locomotion and reinforcement learning, including work in IEEE Transactions on Field Robotics, IROS, CASE and iSpaRo.`}
  path="/publications/"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Publications", path: "/publications/" }]}
>
  <header class="section head">
    <h1>Publications</h1>
    <p class="prose lede">
      {peerReviewedCount} peer-reviewed items, plus work under review. Author order is as
      published, my name in bold. An asterisk marks equal authorship.
    </p>
    <p class="actions no-print">
      <a class="btn" href="/publications.bib">
        Download all citations <span class="btn__sub">BibTeX</span>
      </a>
      <a class="btn" href={profile.links.scholar} rel="me noopener">Google Scholar</a>
      <a class="btn" href={profile.links.orcid} rel="me noopener">ORCID</a>
    </p>
  </header>

  {
    groups.map(([year, items]) => (
      <section class="section yr">
        <div class="section-head">
          <h2 class="tnum">{year}</h2>
          <span class="key">{items.length} {items.length === 1 ? "item" : "items"}</span>
        </div>
        {items.map((p) => <PublicationEntry pub={p} />)}
      </section>
    ))
  }

  {
    pending.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Under review and in submission</h2>
          <span class="key">not yet peer reviewed</span>
        </div>
        <p class="prose lede">
          Listed for completeness. None of these has completed peer review, and they should
          not be cited as though they had.
        </p>
        {pending.map((p) => <PublicationEntry pub={p} />)}
      </section>
    )
  }
</Base>

<style>
  .head { padding-bottom: 0; }
  .lede { margin-top: 0.9rem; font-size: 1.02rem; color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.3rem 0 0; max-width: none; }
  .yr:first-of-type { padding-top: 2rem; }
</style>
