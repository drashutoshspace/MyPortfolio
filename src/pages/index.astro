---
import Base from "~/layouts/Base.astro";
import Plate from "~/components/Plate.astro";
import Email from "~/components/Email.astro";
import PublicationEntry from "~/components/PublicationEntry.astro";
import { profile } from "~/data/profile";
import { themes } from "~/data/research";
import { spaceProjects } from "~/data/projects";
import { peerReviewedCount, getPublication } from "~/data/publications";
import Gallery from "~/components/Gallery.astro";
import Icon from "~/components/Icon.astro";
import { talks } from "~/data/talks";
import { latestNews, kindLabel } from "~/data/news";
import VideoEmbed from "~/components/VideoEmbed.astro";
import PaperFeature from "~/components/PaperFeature.astro";
import { moonbot, moonbotVideo } from "~/data/featured";
import { helpingHut } from "~/data/society";

/* The MoonBot T-FR article and the iSpaRo 2025 paper already lead the page
   under Featured research, so they are not repeated here. */
const featured = [
  "multi-limb-synchronization-motion-stack-hypersphere",
  "human-in-loop-manipulator-control-uncertain-assembly",
]
  .map(getPublication)
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

/* Three plates, one per chapter of the work: MoonBot in the field, the cave
   campaign, and the legged locomotion now under way in Genova. */
const openingPlates: {
  caption: string;
  src: string;
  alt?: string;
  kind?: "photo" | "figure" | "illustration";
  focus?: string;
}[] = [
  {
    caption: "MoonBot in Dragon configuration on a crater rim in regolith simulant, DLR-ESA LUNA facility, Cologne.",
    src: "/media/robotics/luna-dragon-crater-rim.webp",
    focus: "45% 50%",
  },
  {
    caption: "The modular sensor box in Abukuma Cave, a stand-in for lunar caves.",
    src: "/media/robotics/sensorbox-abukuma-cave.webp",
    focus: "50% 100%",
  },
  {
    caption: "Quadrupeds for terrain nobody has surveyed: the problem the work in Genova addresses.",
    src: "/media/illustrations/legged-quadruped-regolith.webp",
    kind: "illustration",
  },
];

const recentProjects = spaceProjects.slice(0, 4);
---

<Base
  title="Home"
  description={profile.positioning}
  path="/"
  type="profile"
  isProfilePage
>
  <section class="section intro">
    <div class="lead">
      <h1>{profile.name}</h1>
      <p class="role">
        <strong>{profile.role}</strong>, {profile.lab} lab,<br />
        {profile.institutionShort}, {profile.city}, {profile.country}
      </p>

      <blockquote class="thesis">{profile.positioning}</blockquote>

      <div class="prose bio">
        {profile.bio.map((para) => <p>{para}</p>)}
      </div>

      <p class="actions no-print">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}><Icon name="email" />Email me</a>
        <a class="btn" href={profile.cvPdf}><Icon name="cv" />Curriculum vitae <span class="btn__sub">PDF</span></a>
        <a class="btn" href={profile.links.scholar} rel="me noopener"><Icon name="scholar" />Scholar</a>
        <a class="btn" href={profile.links.orcid} rel="me noopener"><Icon name="orcid" />ORCID</a>
        <a class="btn" href={profile.links.linkedin} rel="me noopener"><Icon name="linkedin" />LinkedIn</a>
      </p>
    </div>

    <aside class="side">
      <div class="portrait plate">
        <img
          src="/media/ashutosh-mishra.webp"
          alt={`${profile.name}, ${profile.role} at ${profile.institutionShort}`}
          width="558"
          height="582"
          fetchpriority="high"
        />
      </div>

      <dl class="facts">
        <div>
          <dt>Position</dt>
          <dd>{profile.role}, {profile.lab}, {profile.institutionShort}</dd>
        </div>
        <div>
          <dt>Previously</dt>
          <dd>PhD, Space Robotics Lab, Tohoku University</dd>
        </div>
        <div>
          <dt>Programmes</dt>
          <dd>ALTEC; JST Moonshot Goal 3</dd>
        </div>
        <div>
          <dt>Publications</dt>
          <dd>{peerReviewedCount} peer reviewed, <a class="link" href="/publications/">listed here</a></dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="section">
    <div class="section-head"><h2>Featured research</h2></div>

    <div class="feature">
      <figure class="no-print">
        <VideoEmbed video={moonbotVideo} />
      </figure>
      <div class="feature__text">
        <p class="key">IEEE Transactions on Field Robotics, 2025</p>
        <h3><a class="head-link" href="/research/moonbot/">MoonBot: a modular robot for building a Moon base</a></h3>
        <p class="fk">{moonbot.oneLine}</p>
        <p class="no-print"><a class="btn btn--primary" href="/research/moonbot/">About MoonBot</a></p>
      </div>
    </div>

    <div class="feature-paper">
      <PaperFeature />
    </div>
  </section>

  <section class="section plates no-print">
    <div class="plate-row">
      {openingPlates.map((p) => <Plate caption={p.caption} src={p.src} alt={p.alt} kind={p.kind} focus={p.focus} ratio="3 / 2" />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Research</h2>
      <p class="aside">{profile.interests}</p>
    </div>

    <ul class="themes">
      {
        themes.map((t) => (
          <li>
            <h3><a class="head-link" href={`/research/${t.slug}/`}>{t.title}</a></h3>
            {t.current && <p class="now">Current work</p>}
            <p class="q">{t.question}</p>
            <p class="k">{t.kicker}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Speaking and recognition</h2>
      <p class="aside">IAC 2025 in Sydney, a best paper award at iSpaRo 2025, and the Space Studies Program in Houston.</p>
    </div>
    <Gallery items={talks} label="Speaking, panels and recognition" />
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected projects</h2>
    </div>

    <ul class="projects">
      {
        recentProjects.map((p) => (
          <li>
            <div class="pmeta">
              <span class="key tnum">{p.from.slice(0, 4)}</span>
              {p.current && <span class="key">Ongoing</span>}
            </div>
            <div>
              <h3><a class="head-link" href={`/projects/${p.slug}/`}>{p.title}</a></h3>
              {p.site && <p class="site">{p.site}</p>}
              <p class="pk">{p.kicker}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more no-print"><a class="link" href="/projects/">All projects</a></p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected publications</h2>
      <p class="aside">{peerReviewedCount} peer-reviewed items in total, plus work under review.</p>
    </div>

    {featured.map((p) => <PublicationEntry pub={p} />)}

    <p class="more no-print"><a class="link" href="/publications/">All publications</a></p>
  </section>

  <section class="section">
    <div class="society">
      <a class="plate society__fig" href="/society/" style="aspect-ratio: 3 / 2">
        <img src="/media/society/gyankutir-opening-day.webp" alt="Villagers walking in under the GyanKutir banner on the library's opening day." width="1280" height="853" loading="lazy" decoding="async" />
      </a>
      <div>
        <h2>Society</h2>
        <p class="fk">
          Outside the lab I am {helpingHut.role} at Helping Hut, a student-founded NGO running free
          street schooling, a village library and relief drives in India, and I built the platform
          it runs on.
        </p>
        <p class="no-print"><a class="btn" href="/society/">Society work</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Recently</h2>
      <p class="aside"><a class="link" href="/news/">Full timeline</a></p>
    </div>
    <ol class="recent">
      {
        latestNews(4).map((n) => (
          <li>
            <span class="key kindtag">{kindLabel[n.kind]}</span>
            <span class="rt">
              {n.href ? <a class="head-link" href={n.href}>{n.title}</a> : n.title}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head"><h2>Get in touch</h2></div>
    <p class="prose">
      Collaboration enquiries, talk and panel invitations, and questions about the work
      are all welcome. I read every message. Write to <Email />{" "}or{" "}
      <a class="link" href="/contact/">use the contact page</a>.
    </p>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 2rem clamp(2rem, 5vw, 3.5rem); align-items: start; }
  @media (min-width: 900px) { .intro { grid-template-columns: minmax(0, 1fr) 21rem; } }

  .role { font-size: 1rem; color: var(--ink-2); margin: 0.7rem 0 0; line-height: 1.5; max-width: none; }

  .thesis {
    margin: 1.3rem 0 0;
    padding: 0.1rem 0 0.1rem 1.1rem;
    border-left: 3px solid var(--accent);
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.4;
    color: var(--ink);
    max-width: 40ch;
  }

  .bio { margin-top: 1.4rem; }

  .actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.5rem 0 0; max-width: none; }

  .side { display: flex; flex-direction: column; gap: 1.2rem; }
  .portrait { aspect-ratio: 558 / 582; }

  .feature { display: grid; gap: 1.2rem clamp(1.5rem, 4vw, 2.5rem); align-items: center; }
  @media (min-width: 760px) { .feature { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); } }
  .feature h3 { font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.25; margin-top: 0.35rem; }
  .fk { font-size: 0.98rem; line-height: 1.55; color: var(--ink-2); margin: 0.6rem 0 1.1rem; }
  .feature-paper { margin-top: clamp(2rem, 5vw, 3rem); padding-top: clamp(2rem, 5vw, 3rem); border-top: 1px solid var(--rule); }

  .plates { padding-top: 0; border-top: 0 !important; }

  .society { display: grid; gap: 1.2rem clamp(1.5rem, 4vw, 2.5rem); align-items: center; }
  @media (min-width: 760px) { .society { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } }
  .plate-row { display: grid; gap: 1.2rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .plate-row { grid-template-columns: repeat(3, 1fr); } }

  .themes, .projects { list-style: none; margin: 0; padding: 0; }
  .themes { display: grid; gap: 0; }
  .themes li { padding-block: 1.2rem; border-top: 1px solid var(--rule); }
  .themes li:last-child { border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) {
    .themes { grid-template-columns: repeat(3, 1fr); gap: 0 2rem; }
    .themes li { border-bottom: 1px solid var(--rule); }
  }

  .head-link { text-decoration: none; color: var(--ink); }
  .head-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .now { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); margin: 0.3rem 0 0; max-width: none; }
  .q { font-size: 0.97rem; line-height: 1.5; color: var(--ink-2); margin: 0.45rem 0 0; }
  .k { font-size: 0.9rem; line-height: 1.5; color: var(--ink-3); margin: 0.45rem 0 0; }

  .projects li {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .projects li:first-child { border-top: 1px solid var(--rule); }
  @media (min-width: 760px) { .projects li { grid-template-columns: 9rem minmax(0, 1fr); } }
  .pmeta { display: flex; gap: 0.6rem; align-items: baseline; padding-top: 0.25rem; }
  @media (min-width: 760px) { .pmeta { flex-direction: column; gap: 0.15rem; } }
  .site { font-family: var(--serif); font-size: 0.9rem; font-style: italic; color: var(--ink-3); margin: 0.2rem 0 0; max-width: none; }
  .pk { font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); margin: 0.35rem 0 0; }

  .more { margin-top: 1.2rem; font-size: 0.92rem; }

  .recent { list-style: none; margin: 0; padding: 0; }
  .recent li {
    display: grid;
    gap: 0.2rem 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .recent li:first-child { border-top: 1px solid var(--rule); }
  @media (min-width: 760px) { .recent li { grid-template-columns: 9rem minmax(0, 1fr); } }
  .kindtag { color: var(--ink-3); }
  .rt { font-size: 0.97rem; line-height: 1.45; }
</style>
