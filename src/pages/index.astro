---
import Base from "~/layouts/Base.astro";
import Plate from "~/components/Plate.astro";
import Email from "~/components/Email.astro";
import PublicationEntry from "~/components/PublicationEntry.astro";
import { profile } from "~/data/profile";
import { themes } from "~/data/research";
import { spaceProjects } from "~/data/projects";
import { peerReviewedCount, getPublication } from "~/data/publications";

const featured = [
  "moonbot-modular-reconfigurable-robot-moon-base",
  "multi-modal-decentralized-rl-modular-lunar-robots",
  "multi-limb-synchronization-motion-stack-hypersphere",
  "human-in-loop-manipulator-control-uncertain-assembly",
]
  .map(getPublication)
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

/* Captions name the exact photograph wanted, so dropping files into
   /public/media and adding `src` finishes them with no layout change. */
const openingPlates = [
  {
    caption:
      "MoonBot modules reconfiguring on the regolith bed, JAXA Space Exploration Test Field, Sagamihara.",
    ratio: "3 / 2",
  },
  { caption: "Field test inside Abukuma Cave, a lunar cave analogue.", ratio: "3 / 2" },
  {
    caption:
      "Quadruped locomotion trial under the ALTEC project, Dynamic Legged Systems lab, Genova.",
    ratio: "3 / 2",
  },
];

const recentProjects = spaceProjects.slice(0, 4);
---

<Base
  title="Home"
  description={profile.positioning}
  path="/"
  type="profile"
  isProfilePage
>
  <section class="section intro">
    <div class="lead">
      <h1>{profile.name}</h1>
      <p class="role">
        <strong>{profile.role}</strong>, {profile.lab} lab,<br />
        {profile.institutionShort}, {profile.city}, {profile.country}
      </p>

      <blockquote class="thesis">{profile.positioning}</blockquote>

      <div class="prose bio">
        {profile.bio.map((para) => <p>{para}</p>)}
      </div>

      <p class="actions no-print">
        <Email class="btn btn--primary" />
        <a class="btn" href={profile.cvPdf}>Curriculum vitae <span class="btn__sub">PDF</span></a>
        <a class="btn" href={profile.links.scholar} rel="me noopener">Google Scholar</a>
        <a class="btn" href={profile.links.orcid} rel="me noopener">ORCID</a>
      </p>
    </div>

    <aside class="side">
      <div class="portrait plate">
        <img
          src="/media/ashutosh-mishra.png"
          alt={`${profile.name}, ${profile.role} at ${profile.institutionShort}`}
          width="558"
          height="582"
          fetchpriority="high"
        />
      </div>

      <dl class="facts">
        <div>
          <dt>Position</dt>
          <dd>{profile.role}, {profile.lab}, {profile.institutionShort}</dd>
        </div>
        <div>
          <dt>Previously</dt>
          <dd>PhD, Space Robotics Lab, Tohoku University</dd>
        </div>
        <div>
          <dt>Programmes</dt>
          <dd>ALTEC; JST Moonshot Goal 3</dd>
        </div>
        <div>
          <dt>Publications</dt>
          <dd>{peerReviewedCount} peer reviewed, <a class="link" href="/publications/">listed here</a></dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="section plates no-print">
    <div class="plate-row">
      {openingPlates.map((p, i) => <Plate caption={p.caption} ratio={p.ratio} fig={i + 1} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Research</h2>
      <p class="aside">
        Three directions, one problem: getting robots to do useful physical work on a
        surface where nobody can come and help them.
      </p>
    </div>

    <ul class="themes">
      {
        themes.map((t) => (
          <li>
            <h3><a class="head-link" href={`/research/${t.slug}/`}>{t.title}</a></h3>
            {t.current && <p class="now">Current work</p>}
            <p class="q">{t.question}</p>
            <p class="k">{t.kicker}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected projects</h2>
      <p class="aside">Field campaigns and systems, each with its own page.</p>
    </div>

    <ul class="projects">
      {
        recentProjects.map((p) => (
          <li>
            <div class="pmeta">
              <span class="key tnum">{p.from.slice(0, 4)}</span>
              {p.current && <span class="key">Ongoing</span>}
            </div>
            <div>
              <h3><a class="head-link" href={`/projects/${p.slug}/`}>{p.title}</a></h3>
              {p.site && <p class="site">{p.site}</p>}
              <p class="pk">{p.kicker}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more no-print"><a class="link" href="/projects/">All projects</a></p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected publications</h2>
      <p class="aside">{peerReviewedCount} peer-reviewed items in total, plus work under review.</p>
    </div>

    {featured.map((p) => <PublicationEntry pub={p} />)}

    <p class="more no-print"><a class="link" href="/publications/">All publications</a></p>
  </section>

  <section class="section">
    <div class="section-head"><h2>Get in touch</h2></div>
    <p class="prose">
      Collaboration enquiries, talk and panel invitations, and questions about the work
      are all welcome. I read every message. Write to <Email /> or
      <a class="link" href="/contact/">use the contact page</a>.
    </p>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 2rem clamp(2rem, 5vw, 3.5rem); align-items: start; }
  @media (min-width: 900px) { .intro { grid-template-columns: minmax(0, 1fr) 21rem; } }

  .role { font-size: 1rem; color: var(--ink-2); margin: 0.7rem 0 0; line-height: 1.5; max-width: none; }

  .thesis {
    margin: 1.3rem 0 0;
    padding: 0.1rem 0 0.1rem 1.1rem;
    border-left: 3px solid var(--accent);
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.4;
    color: var(--ink);
    max-width: 40ch;
  }

  .bio { margin-top: 1.4rem; }

  .actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.5rem 0 0; max-width: none; }

  .side { display: flex; flex-direction: column; gap: 1.2rem; }
  .portrait { aspect-ratio: 558 / 582; }

  .plates { padding-top: 0; border-top: 0 !important; }
  .plate-row { display: grid; gap: 1.2rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .plate-row { grid-template-columns: repeat(3, 1fr); } }

  .themes, .projects { list-style: none; margin: 0; padding: 0; }
  .themes { display: grid; gap: 0; }
  .themes li { padding-block: 1.2rem; border-top: 1px solid var(--rule); }
  .themes li:last-child { border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) {
    .themes { grid-template-columns: repeat(3, 1fr); gap: 0 2rem; }
    .themes li { border-bottom: 1px solid var(--rule); }
  }

  .head-link { text-decoration: none; color: var(--ink); }
  .head-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .now { font-family: var(--mono); font-size: 0.7rem; color: var(--accent); margin: 0.3rem 0 0; max-width: none; }
  .q { font-size: 0.97rem; line-height: 1.5; color: var(--ink-2); margin: 0.45rem 0 0; }
  .k { font-size: 0.85rem; line-height: 1.5; color: var(--ink-3); margin: 0.45rem 0 0; }

  .projects li {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .projects li:first-child { border-top: 1px solid var(--rule); }
  @media (min-width: 760px) { .projects li { grid-template-columns: 9rem minmax(0, 1fr); } }
  .pmeta { display: flex; gap: 0.6rem; align-items: baseline; padding-top: 0.25rem; }
  @media (min-width: 760px) { .pmeta { flex-direction: column; gap: 0.15rem; } }
  .site { font-family: var(--serif); font-size: 0.86rem; font-style: italic; color: var(--ink-3); margin: 0.2rem 0 0; max-width: none; }
  .pk { font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); margin: 0.35rem 0 0; }

  .more { margin-top: 1.2rem; font-size: 0.92rem; }
</style>
