---
import Base from "~/layouts/Base.astro";
import { newsByYear, kindLabel } from "~/data/news";
import { profile } from "~/data/profile";

const years = newsByYear();
/* Entries whose month is not on record show nothing rather than a month
   nobody verified. The year heading already places them. */
const fmt = (d: string, unconfirmed?: boolean) => {
  if (unconfirmed) return "";
  const [y, m] = d.split("-");
  return new Date(Number(y), Number(m) - 1).toLocaleDateString("en-GB", { month: "short" });
};
---

<Base
  title="News"
  description={`Dated record of appointments, papers, awards, talks and field campaigns for ${profile.name}, from the doctorate at Tohoku University to the current postdoctoral post at Istituto Italiano di Tecnologia in Genova.`}
  path="/news/"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "News", path: "/news/" }]}
>
  <header class="section head">
    <h1>News</h1>
    <p class="prose lede">
      Appointments, papers, awards, talks and field campaigns, most recent first.
    </p>
  </header>

  <div class="section timeline">
    {
      years.map(([year, items]) => (
        <section class="year">
          <h2 class="tnum">{year}</h2>
          <ol class="items">
            {items.map((n) => (
              <li>
                <div class="meta">
                  {fmt(n.date, n.monthUnconfirmed) && <span class="key tnum">{fmt(n.date, n.monthUnconfirmed)}</span>}
                  <span class="key kind">{kindLabel[n.kind]}</span>
                </div>
                <div class="body">
                  <h3>
                    {n.href ? <a class="head-link" href={n.href}>{n.title}</a> : n.title}
                  </h3>
                  {n.detail && <p class="detail">{n.detail}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .head { padding-bottom: 0; }
  .lede { margin-top: 0.9rem; }

  .year + .year { margin-top: 2.4rem; }
  .year > h2 {
    font-size: 1.15rem;
    color: var(--ink-3);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 0.4rem;
  }

  .items { list-style: none; margin: 0; padding: 0; }

  .items li {
    position: relative;
    display: grid;
    gap: 0.3rem 1.5rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  @media (min-width: 760px) {
    .items li { grid-template-columns: 9.5rem minmax(0, 1fr); }
    /* The spine: a hairline down the date column, with a mark per entry. It
       carries the chronology, which is the one thing a timeline must encode. */
    .items li::before {
      content: "";
      position: absolute;
      left: 8.4rem;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--rule);
    }
    .items li::after {
      content: "";
      position: absolute;
      left: calc(8.4rem - 2.5px);
      top: 1.55rem;
      width: 6px;
      height: 6px;
      border-radius: 99px;
      background: var(--accent);
    }
    .items li:first-child::before { top: 1.55rem; }
    .items li:last-child::before { bottom: auto; height: 1.55rem; }
  }

  .meta { display: flex; gap: 0.6rem; align-items: baseline; padding-top: 0.2rem; flex-wrap: wrap; }
  @media (min-width: 760px) { .meta { flex-direction: column; gap: 0.15rem; } }
  .kind { color: var(--ink-3); }

  h3 { font-size: 1rem; line-height: 1.35; }
  .head-link { text-decoration: none; color: var(--ink); }
  .head-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .detail { font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); margin: 0.35rem 0 0; }
</style>
