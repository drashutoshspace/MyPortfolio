---
import Base from "~/layouts/Base.astro";
import { collaborations } from "~/data/collaborations";
import { getProject } from "~/data/projects";
import { profile } from "~/data/profile";
---

<Base
  title="Collaborations"
  description={`Institutions and researchers ${profile.name} has worked with, including Istituto Italiano di Tecnologia, Tohoku University Space Robotics Lab, the JAXA Space Exploration Test Field, NASA Ames via the International Space University, ISRO and IIT Delhi.`}
  path="/collaborations/"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Collaborations", path: "/collaborations/" }]}
>
  <header class="section head">
    <h1>Collaborations</h1>
    <p class="prose lede">
      The work below was done with these groups. Space robotics is not a solo discipline:
      hardware that has to survive a field campaign takes a lab, and the interesting problems
      sit where two groups' expertise meet.
    </p>
  </header>

  <div class="section list">
    {
      collaborations.map((c) => (
        <article class="item">
          <div class="meta">
            <span class="key tnum">{c.years}</span>
            {c.current && <span class="key now">Current</span>}
          </div>
          <div class="body">
            <h2>{c.org}</h2>
            <p class="place">{c.place}</p>
            {c.people && c.people.length > 0 && (
              <p class="people">With {c.people.join(", ")}</p>
            )}
            <p class="what">{c.what}</p>
            {c.projects && c.projects.length > 0 && (
              <p class="links no-print">
                {c.projects.map((slug) => {
                  const proj = getProject(slug);
                  return proj ? (
                    <a class="link" href={`/projects/${proj.slug}/`}>{proj.title}</a>
                  ) : null;
                })}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .head { padding-bottom: 0; }
  .lede { margin-top: 0.9rem; }

  .item {
    display: grid;
    gap: 0.35rem 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .item:first-child { border-top: 1px solid var(--rule); }
  @media (min-width: 780px) { .item { grid-template-columns: 9.5rem minmax(0, 1fr); } }

  .meta { display: flex; gap: 0.6rem; align-items: baseline; padding-top: 0.3rem; flex-wrap: wrap; }
  @media (min-width: 780px) { .meta { flex-direction: column; gap: 0.15rem; } }
  .now { color: var(--accent); }

  h2 { font-size: 1.08rem; line-height: 1.3; }
  .place { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-3); margin: 0.3rem 0 0; max-width: none; }
  .people { font-family: var(--serif); font-style: italic; font-size: 0.9rem; color: var(--ink-2); margin: 0.4rem 0 0; max-width: none; }
  .what { font-size: 0.96rem; line-height: 1.6; color: var(--ink-2); margin: 0.55rem 0 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin: 0.6rem 0 0; font-size: 0.88rem; max-width: none; }
</style>
