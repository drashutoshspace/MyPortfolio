---
import "~/styles/global.css";
import SEO from "~/components/SEO.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: "website" | "article" | "profile";
  citation?: {
    title: string;
    authors: string[];
    venue: string;
    year: number;
    doi?: string;
  };
  breadcrumbs?: { name: string; path: string }[];
  isProfilePage?: boolean;
  creativeWork?: {
    name: string;
    description: string;
    from: string;
    to: string;
    keywords: string[];
    location?: string;
  };
  /** The homepage runs its hero full-bleed under the bar. */
  wide?: boolean;
}

const { wide = false, ...seo } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" href="/sitemap-index.xml" />
    {/* Follows the reader's system setting. No toggle: it would be the only
        client JavaScript on the site, and the one component able to break
        rendering for everyone. */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1317" media="(prefers-color-scheme: dark)" />
    <SEO {...seo} />
    {/* The site's only blocking script, ~200 bytes. It applies a stored theme
        choice before first paint; without it a visitor who chose dark would
        see a flash of light on every navigation. Default with no stored
        choice is light. */}
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || t === "auto") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      {
        wide ? (
          <slot />
        ) : (
          <div class="shell">
            <slot />
          </div>
        )
      }
    </main>
    <Footer />
  </body>
</html>
