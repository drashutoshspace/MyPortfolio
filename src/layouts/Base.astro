---
import "~/styles/global.css";
import SEO from "~/components/SEO.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: "website" | "article" | "profile";
  citation?: {
    title: string;
    authors: string[];
    venue: string;
    year: number;
    doi?: string;
  };
  breadcrumbs?: { name: string; path: string }[];
  isProfilePage?: boolean;
  creativeWork?: {
    name: string;
    description: string;
    from: string;
    to: string;
    keywords: string[];
    location?: string;
  };
  /** The homepage runs its hero full-bleed under the bar. */
  wide?: boolean;
}

const { wide = false, ...seo } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Light is the default regardless of system setting, so a single
        theme-color is correct; the toggle script updates it when dark is
        chosen. Two media-gated values would paint the browser chrome dark for
        a dark-system visitor looking at a light page. */}
    <meta name="theme-color" content="#ffffff" />
    <SEO {...seo} />
    {/* The site's only blocking script, ~200 bytes. It applies a stored theme
        choice before first paint; without it a visitor who chose dark would
        see a flash of light on every navigation. Default with no stored
        choice is light. */}
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || t === "auto") {
          document.documentElement.dataset.theme = t;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m && t === "dark") m.setAttribute("content", "#0f1317");
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      {
        wide ? (
          <slot />
        ) : (
          <div class="shell">
            <slot />
          </div>
        )
      }
    </main>
    <Footer />
    {/* Vercel Web Analytics. Cookieless and no visitor identifiers, so it needs
        no consent banner under GDPR, which matters for an EU-hosted site. It
        reports page views, referrers and countries in aggregate. It cannot and
        will not tell you which individual visited: that would need cookies or
        fingerprinting, and consent. Served from the site's own origin, so no
        third-party request. Requires Web Analytics to be switched on for the
        project in the Vercel dashboard. */}
    <script defer src="/_vercel/insights/script.js" is:inline></script>
  </body>
</html>
