# Contact form. The form renders only when RESEND_API_KEY is present, so the
# site never ships a submit button that fails.
#
# Verify the SUBDOMAIN mail.drmishra.space in Resend, not the root domain.
# drmishra.space publishes p=reject; sp=reject; adkim=s; aspf=s, so the DKIM
# d= domain must exactly match the From domain. Sending from the subdomain
# satisfies strict alignment with no change to the DMARC record.
RESEND_API_KEY=""

# Optional overrides.
# CONTACT_TO="contact@drmishra.space"
# CONTACT_FROM="Contact form <noreply@mail.drmishra.space>"
